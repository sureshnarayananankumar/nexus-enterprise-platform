# Copy to .env (git-ignored). Values here are local-development defaults only.
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
MONGO_USER=nexus
MONGO_PASSWORD=nexus
REDIS_PASSWORD=nexus
GRAFANA_USER=admin
GRAFANA_PASSWORD=nexus

IDENTITY_PROFILE=dev
NEXUS_JWT_ISSUER=http://localhost:8081
# PEM contents (newlines may be written as \n). Leave empty in dev to use an ephemeral key.
NEXUS_JWT_PRIVATE_KEY=
NEXUS_JWT_PUBLIC_KEY=
